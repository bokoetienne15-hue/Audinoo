rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Each user can manage only their own profile picture.
    // Accepted formats: JPG, PNG and WebP, up to 5 MiB.
    match /avatars/{userId}/profile.{extension} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && extension in ['jpg', 'png', 'webp']
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
