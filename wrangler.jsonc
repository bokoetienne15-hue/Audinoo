{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audinoo-test",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-03",
  "vars": {
    "FEDAPAY_ENVIRONMENT": "live"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "audinoo"
    }
  ],
  "triggers": {
    "crons": [
      "0 2 * * *"
    ]
  },
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
