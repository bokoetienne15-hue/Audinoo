{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audinoo-test",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "audinoo"
    }
  ],
  "triggers": { "crons": ["0 2 * * *"] },
  "workers_dev": true
}
